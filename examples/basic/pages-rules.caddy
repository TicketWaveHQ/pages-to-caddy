	# _headers line 18: /embed/*
	@p2c_h18 path_regexp p2c_h18 ^/embed/(.*)$
	header @p2c_h18 -X-Frame-Options

	# _headers line 22: /downloads/:file
	@p2c_h22 path_regexp p2c_h22 ^/downloads/([^/]+)$
