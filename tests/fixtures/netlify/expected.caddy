# Generated by pages-to-caddy 0.1.0 from _headers and _redirects
# (Netlify rules). Edit the source files and generate again.
route {
	# _redirects line 2 skipped (host-level): https://www.example.com/* https://example.com/:splat 301!

	# _redirects line 5: /home /
	@p2c_r5 path_regexp p2c_r5 ^/home/?$
	redir @p2c_r5 /{?query} 301

	# _redirects line 7: /temporary /elsewhere 302
	@p2c_r7 path_regexp p2c_r7 ^/temporary/?$
	redir @p2c_r7 /elsewhere{?query} 302

	# _redirects line 8: /old-docs/* /docs/:splat
	@p2c_r8 path_regexp p2c_r8 ^/old-docs/(.*?)/?$
	redir @p2c_r8 /docs/{re.p2c_r8.1}{?query} 301

	# _redirects line 9: /news/:year/:slug /articles/:slug 301
	@p2c_r9 path_regexp p2c_r9 ^/news/([^/]+)/([^/]+)/?$
	redir @p2c_r9 /articles/{re.p2c_r9.2}{?query} 301

	# _redirects line 10: /forced /docs/ 301!
	@p2c_r10 path_regexp p2c_r10 ^/forced/?$
	redir @p2c_r10 /docs/{?query} 301

	# _redirects line 13: /home/ /other
	@p2c_r13 path_regexp p2c_r13 ^/home/?$
	redir @p2c_r13 /other{?query} 301

	# _headers line 2: /*
	header X-Frame-Options "DENY"

	# _headers line 5: /images/*.png
	@p2c_h5 path_regexp p2c_h5 ^/images/(.*)\.png$
	header @p2c_h5 Cache-Control "public, max-age=86400"

	# _headers line 9: /*/print/*
	@p2c_h9 path_regexp p2c_h9 ^/(.*)/print/(.*)$
	header @p2c_h9 X-Robots-Tag "noindex"

	# _headers line 13: /docs/:page
	@p2c_h13 path_regexp p2c_h13 ^/docs/([^/]+)$
	header @p2c_h13 X-Docs "yes"
}
