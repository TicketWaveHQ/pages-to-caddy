# (Cloudflare Pages rules). Edit the source files and generate again.
route {
	# _redirects line 1: /a /b 301
	@p2c_r1 path_regexp p2c_r1 ^/a$
	redir @p2c_r1 /b{?query} 301

	# _redirects line 2: /blog/* /news/:splat 301
	@p2c_r2 path_regexp p2c_r2 ^/blog/(.*)$
	redir @p2c_r2 /news/{re.p2c_r2.1}{?query} 301

	# _redirects line 3: /out https://elsewhere.example.com/landing 302
	@p2c_r3 path_regexp p2c_r3 ^/out$
	redir @p2c_r3 https://elsewhere.example.com/landing{?query} 302
}
